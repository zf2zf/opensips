# /etc/keepalived/keepalived.conf - 节点 2 (standby / BACKUP)

global_defs {
    router_id opensips_backup
    enable_script_security
    script_user root
}

vrrp_script chk_opensips {
    script "/etc/keepalived/chk_opensips.sh"
    interval 2
    weight -20
    fall 3
    rise 2
    timeout 5
}

vrrp_instance VI_1 {
    state BACKUP
    interface eth0
    virtual_router_id 51
    priority 90
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass 1234
    }

    virtual_ipaddress {
        20.20.136.100/24 dev eth0
    }

    track_script {
        chk_opensips
    }

    # 节点 2 状态切换时执行 notify 脚本
    notify_master "/etc/keepalived/notify.sh master"
    notify_backup "/etc/keepalived/notify.sh backup"
    notify_fault "/etc/keepalived/notify.sh fault"
}
