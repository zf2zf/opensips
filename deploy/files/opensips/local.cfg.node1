# 节点 1 私有配置 - active / master
# 由 opensips_proxy_ha.cfg 通过 include_file 引入

# 节点 1 物理 IP 监听 SIP 5060，对外通告 VIP
listen=udp:20.20.136.66:5060 AS 20.20.136.100:5060

# clusterer BIN 协议监听（节点间同步）
listen=bin:20.20.136.66:5566

# clusterer 节点身份
modparam("clusterer", "my_node_id", 1)
modparam("clusterer", "neighbor_node_info", "id=2; url=bin:20.20.136.67:5566")

# httpd 监听本机 IP（避免 0.0.0.0）
modparam("httpd", "ip", "20.20.136.66")
