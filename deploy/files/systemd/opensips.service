[Unit]
Description=OpenSIPS GB28181 HA Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=opensips
Group=opensips
ExecStart=/usr/local/sbin/opensips -f /etc/opensips/opensips_proxy_ha.cfg -P /run/opensips/opensips.pid
ExecReload=/bin/kill -HUP $MAINPID
PIDFile=/run/opensips/opensips.pid
Restart=on-failure
RestartSec=5
RuntimeDirectory=opensips
RuntimeDirectoryMode=0755
LimitNOFILE=65536

# 等待 clusterer 邻居就绪（节点 1 先起，节点 2 后起）
ExecStartPre=/bin/sleep 2

[Install]
WantedBy=multi-user.target
