#!/bin/bash
# =============================================================================
# OpenSIPS GB28181 HA 部署 - 环境变量模板
# 复制本文件为 env.sh，按实际环境修改，然后 source env.sh
# =============================================================================

# 角色：本机是 node1 (active/master) 还是 node2 (standby/backup)
#   deploy_node1.sh 会校验 ROLE=node1
#   deploy_node2.sh 会校验 ROLE=node2
#   sync_to_node2.sh 始终在节点 1 上跑
ROLE=node1

# ---- 网络参数 ----
NODE1_IP=20.20.136.66
NODE1_IF=eth0

NODE2_IP=20.20.136.67
NODE2_IF=eth0

# 虚拟 IP（设备/平台连接的地址）
VIP=20.20.136.100

# ---- 端口 ----
SIP_PORT=5060
BIN_PORT=5566
HTTP_PORT=8080

# ---- clusterer / usrloc / dispatcher ----
CLUSTER_ID=1
SHTAG=sip_active

# ---- OpenSIPS 路径 ----
OPEN_SIPS_BIN=/usr/local/sbin/opensips
OPEN_SIPS_CFG=/etc/opensips/opensips_proxy_ha.cfg
OPEN_SIPS_USER=opensips
OPEN_SIPS_GROUP=opensips
OPEN_SIPS_MOD_DIR=/usr/local/lib64/opensips/modules

# ---- 系统路径 ----
KEEPALIVED_CFG=/etc/keepalived/keepalived.conf
KEEPALIVED_CHK=/etc/keepalived/chk_opensips.sh
SYSTEMD_UNIT=/etc/systemd/system/opensips.service

# ---- 数据目录 ----
SQLITE_DIR=/var/lib/opensips
DBTEXT_DIR=/etc/opensips/dbtext

# ---- SSH 到节点 2（仅 sync_to_node2.sh 用）----
NODE2_SSH="root@${NODE2_IP}"

# ---- 源码 build（可选；留空表示使用已装的 opensips）----
SRC_DIR=$HOME/work/opensips

# ---- 验收 ----
VERIFY_DEVICE_ID=11010000001320000001
VERIFY_PLATFORM=10.0.0.10:5060
