global_defs {
    router_id opensips_master
}

vrrp_script chk_opensips {
    script "/opt/zfnproxy/opensips/etc/keepalived/chk_opensips.sh"
    interval 2
    weight -20
}

vrrp_instance VI_1 {
    state MASTER
    interface eth0
    virtual_router_id 51
    priority 100
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass 1234
    }
    virtual_ipaddress {
        VIP dev eth0
    }
    track_script {
        chk_opensips
    }
}
